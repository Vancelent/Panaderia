# Copiá este archivo a .env y completá los valores. .env NUNCA se sube a git.

# --- Base de datos (docker-compose) ---
POSTGRES_USER=panaderia
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_DB=erp_panaderia

# Fuera de Docker, la API necesita la URL completa:
# DATABASE_URL=postgresql://panaderia:<clave>@localhost:5433/erp_panaderia

# --- API ---
ENV=development
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# true en producción (requiere HTTPS)
COOKIE_SECURE=false
# Solo si el frontend se sirve desde otro origen (sin el proxy de Vite / reverse proxy)
CORS_ORIGINS=
ZONA_HORARIA=America/Argentina/Buenos_Aires
# Medios que ofrece la caja (nombres, separados por coma). La cuenta corriente se ofrece
# siempre que la venta tenga un cliente. Agregá QR cuando exista la integración.
MEDIOS_PAGO_HABILITADOS=EFECTIVO,TRANSFERENCIA,TARJETA

# --- Reparto ---
# Ubicación de la panadería: punto de partida de la ruta sugerida (opcional; sin esto se parte
# del centro de las paradas). Coordenadas decimales, p. ej. -34.603722 y -58.381592.
PANADERIA_LATITUD=
PANADERIA_LONGITUD=
# Días que se conserva la traza GPS cruda del recorrido (el resumen de cada hoja es permanente).
# La limpieza la hace a diario:  docker compose exec web python -m app.cli mantenimiento-gps
RETENCION_GPS_DIAS=90
# Una entrega confirmada a más de estos metros del punto cargado se marca como alerta en el mapa
ALERTA_DISTANCIA_ENTREGA_M=300

# --- Producción (docker-compose.prod.yml; ver docs/despliegue.md) ---
# El compose de producción ya fija ENV=production, COOKIE_SECURE=true, COOKIE_PREFIX=__Host-,
# DB_POOL_SIZE=4 y DB_MAX_OVERFLOW=2: no hace falta repetirlos acá.
# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels). Solo con el perfil "tunnel".
CLOUDFLARE_TUNNEL_TOKEN=
# Etiqueta de las imágenes (panaderia-api:<VERSION>); sirve para volver a una versión anterior.
VERSION=latest
# Archivo de variables que lee el contenedor api (por defecto .env).
# ENV_FILE=.env

# --- Respaldos (los lee deploy/backup.sh desde el cron del host; ver deploy/crontab.ejemplo) ---
# BACKUP_DIR=/var/backups/panaderia
# BACKUP_KEEP=14
# RCLONE_REMOTE=b2:panaderia-backups
# BACKUP_PING_URL=

# --- Autenticación (docs/rfc-001 §2) ---
# Secreto del servidor para guardar los PIN (HMAC + bcrypt). OBLIGATORIO en producción (≥ 32 caracteres):
# sin él, una copia de la base permitiría averiguar un PIN de 4 dígitos en segundos. En desarrollo puede
# quedar vacío. Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No lo cambies después de cargar PIN: invalidaría todos los PIN guardados (habría que volver a cargarlos).
PIN_PEPPER=
# Ingreso con Google. Sin GOOGLE_CLIENT_ID el botón no aparece y el resto sigue funcionando (contraseña y
# PIN). Se crea en https://console.cloud.google.com/apis/credentials (cliente "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# La URL de retorno que se registra en Google Cloud: https://<tu-dominio>/api/v1/auth/google/callback
# (en desarrollo: http://localhost:5173/api/v1/auth/google/callback)
OAUTH_REDIRECT_URL=
# Client IDs de la app móvil (Android e iOS), separados por coma. Solo para la app.
GOOGLE_CLIENT_IDS_MOVIL=
# Limita el ingreso a un dominio de Google Workspace (opcional)
GOOGLE_HOSTED_DOMAIN=
# Orígenes extra (además del propio host) desde los que se aceptan escrituras con cookie. Normalmente vacío.
ORIGENES_PERMITIDOS=
# Intentos de PIN fallidos antes de bloquearlo, y minutos que dura una sesión con PIN
# PIN_MAX_FALLOS=5
# PIN_SESION_MINUTOS=600
# Minutos que vale una autenticación para la gestión sensible (precios, usuarios, ajustes…)
# REAUTENTICACION_MINUTOS=15
