# Caddy de producción (docs/rfc-001 §7). Sirve el build del frontend y reenvía /api a la API,
# todo en el mismo origen (así las cookies SameSite=Strict y el CSRF funcionan sin CORS).
#
# El TLS lo termina Cloudflare (túnel): Caddy escucha solo en HTTP dentro de la red `borde` y no
# intenta pedir certificados. Para publicar Caddy directamente con certificado propio, ver
# docs/despliegue.md ("Sin túnel").

{
	admin off
	auto_https off

	servers {
		# Solo se confía en el encabezado con la IP real cuando la conexión llega desde la red
		# `borde` (el contenedor cloudflared o el puerto local). Cualquier otro origen no puede
		# falsificar su IP, y el límite de intentos de login ve la IP verdadera.
		trusted_proxies static 172.30.0.0/24
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# 'unsafe-inline' solo en estilos: React y Leaflet (marcadores del mapa) usan style="…".
		# Los scripts son siempre del propio origen. Los mosaicos del mapa vienen de OpenStreetMap
		# y la tipografía de Google Fonts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# La documentación interactiva no se publica (la API ya la apaga con ENV=production; esto
	# es una segunda capa por si alguien cambiara esa variable).
	handle /api/docs* {
		respond "No encontrado" 404
	}
	handle /api/redoc* {
		respond "No encontrado" 404
	}
	handle /api/openapi.json {
		respond "No encontrado" 404
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# IP real del cliente (ver trusted_proxies): uvicorn la toma de acá
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	handle {
		root * /srv
		encode zstd gzip

		# Los archivos de /assets llevan un hash en el nombre: se pueden cachear para siempre.
		# Todo lo demás (index.html) se revalida siempre, así una versión nueva se ve al recargar.
		@hasheados path /assets/*
		header @hasheados Cache-Control "public, max-age=31536000, immutable"
		@revalidar not path /assets/*
		header @revalidar Cache-Control "no-cache"

		# Rutas del frontend (React Router): cualquier ruta que no sea un archivo devuelve index.html
		try_files {path} /index.html
		file_server
	}
}
