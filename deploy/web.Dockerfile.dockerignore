# Contexto de build de deploy/web.Dockerfile (la raíz del repositorio): solo hace falta frontend/,
# packages/core y deploy/Caddyfile. BuildKit usa este archivo en lugar de un .dockerignore en la raíz.
.git
.env
.env.*
venv
backend
docs
README.md
frontend/node_modules
frontend/dist
packages/*/node_modules
deploy/*
!deploy/Caddyfile
